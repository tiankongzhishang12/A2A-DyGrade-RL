# 统一文本文件换行符，避免 Windows/Linux 协作时产生整文件伪差异。
* text=auto

*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.gitattributes text eol=lf
.gitignore text eol=lf

# 常见研究与办公产物按二进制处理。
